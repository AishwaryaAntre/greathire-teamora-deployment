PORT=5000
# Vercel frontend domain(s) that are allowed to call this API.
# Example: https://great-hire-teamora.vercel.app
# CLIENT_ORIGIN=https://your-frontend-domain.vercel.app

CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB Atlas (live cloud DB) ---
# Replace this with your real Atlas connection string.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/greathire?retryWrites=true&w=majority

MONGODB_URI=mongodb://127.0.0.1:27017/greathire
#MONGODB_URI="mongodb+srv://anshuls12120_db_user:pK4igvkKjHuFNytS@cluster0.jlby38o.mongodb.net"

MONGODB_DB_NAME=greathire

# Set to "false" after your first successful run if you don't want the demo
# employees/attendance/leave/etc re-seeded every time the DB is empty.
SEED_DEMO_DATA=true

# --- Auth (JWT) ---
# Change this to a long random string before deploying anywhere real.

JWT_SECRET=devonlyinsecuresecretchangemenow
JWT_EXPIRES_IN=1d
JWT_REMEMBER_ME_EXPIRES_IN=30d

JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_ME_EXPIRES_IN=30d

# Password every seeded demo user (see src/data/usersStore.js) can log in with.
SEED_USER_PASSWORD=pAssword123

# --- OAuth (optional) ---
# "Continue with Google/Microsoft" on the login page only works once these are set.
# Leave blank to keep those buttons disabled — everything else still works fine.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-render-backend.onrender.com/api/auth/oauth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=https://your-render-backend.onrender.com/api/auth/oauth/microsoft/callback

