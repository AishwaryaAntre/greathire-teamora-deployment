PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB ---
# Local dev:   mongodb://127.0.0.1:27017/greathire-teamora
# Atlas (prod): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/greathire-teamora?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/greathire

# Set to "false" after your first successful run if you don't want the demo
# employees/attendance/leave/etc re-seeded every time the DB is empty.
SEED_DEMO_DATA=true

# --- Auth (JWT) ---
# Change this to a long random string before deploying anywhere real.
JWT_SECRET=devonlyinsecuresecretchangemenow
JWT_EXPIRES_IN=1d
JWT_REMEMBER_ME_EXPIRES_IN=30d

JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_ME_EXPIRES_IN=30d

# Password every seeded demo user (see src/data/usersStore.js) can log in with.
SEED_USER_PASSWORD=pAssword123

# --- OAuth (optional) ---
# "Continue with Google/Microsoft" on the login page only works once these are set.
# Leave blank to keep those buttons disabled — everything else still works fine.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/auth/oauth/microsoft/callback

