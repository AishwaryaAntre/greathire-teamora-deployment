PORT=5000

# Vercel frontend domain(s) that are allowed to call this API. Also used to
# build the password-reset link that gets emailed to users.
# Example: https://great-hire-teamora.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB Atlas (live cloud DB) ---
# Replace this with your real Atlas connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# MONGODB_DB_NAME=teamora

# Set to "false" after your first successful run if you don't want the demo
# employees/attendance/leave/etc re-seeded every time the DB is empty.
SEED_DEMO_DATA=true

# --- Auth (JWT) ---
# Change this to a long random string before deploying anywhere real.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_REMEMBER_ME_EXPIRES_IN=30d

JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_ME_EXPIRES_IN=60d

# Password every seeded demo user (see src/data/usersStore.js) can log in with.
SEED_USER_PASSWORD=password123

# --- OAuth (optional) ---
# "Continue with Google/Microsoft" on the login page only works once these are set.
# Leave blank to keep those buttons disabled — everything else still works fine.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=

# --- Resend (forgot/reset password emails) ---
# Get a key at https://resend.com/api-keys. Leave blank in local dev to skip
# sending and just log the reset link instead.
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account.
RESEND_FROM_EMAIL=Teamora <onboarding@resend.dev>
