PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (optional — leave blank to run on in-memory data, same as before.
# Set this to enable real persistence for Employee + User accounts.
# Attendance/Leave/Notifications/Messages/Reports are still in-memory for now.)
MONGODB_URI=
MONGODB_DB_NAME=greathire

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_REMEMBER_ME_EXPIRES_IN=30d

# Every seeded demo employee can log in with this password
SEED_USER_PASSWORD=password123

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
