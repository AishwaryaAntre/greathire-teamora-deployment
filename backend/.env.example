PORT=5000
# Frontend URL exposed to the browser.
# For a Vercel deployment, set this to your Vercel domain, e.g.
# CLIENT_ORIGIN=https://great-hire-teamora.vercel.app
# CLIENT_ORIGIN=https://your-frontend-domain.vercel.app
CLIENT_ORIGIN=http://localhost:5173


# MongoDB Atlas live database connection string.
# Replace the placeholder below with the connection string from Atlas.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/greathire?retryWrites=true&w=majority
#MONGODB_URI=mongodb://127.0.0.1:27017/greathire
MONGODB_URI=mongodb+srv://patilmanas481_db_user:mEWEhcpNrpZGqbYO@cluster0.coq71je.mongodb.net

MONGODB_DB_NAME=greathire

# Optional: keep this if you also want a separate local development origin
# CLIENT_ORIGIN=http://localhost:5173,https://your-frontend-domain.vercel.app

# JWT
JWT_SECRET=devonlyinsecuresecretchangemenow
JWT_EXPIRES_IN=1d
JWT_REMEMBER_ME_EXPIRES_IN=30d

# Refresh tokens (opaque, rotated on every use — see /api/auth/refresh)
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_ME_EXPIRES_IN=30d

# Every seeded demo employee can log in with this password
SEED_USER_PASSWORD=pAssword123

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback

# Microsoft OAuth (optional)


MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/auth/oauth/microsoft/callback
